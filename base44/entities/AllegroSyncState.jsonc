{
  "name": "AllegroSyncState",
  "type": "object",
  "properties": {
    "node_id": {
      "type": "string",
      "description": "ID kategorii Allegro (w\u0119ze\u0142 do przetworzenia)"
    },
    "full_path": {
      "type": "string",
      "description": "Pe\u0142na \u015bcie\u017cka kategorii od dzia\u0142u"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "done"
      ],
      "default": "pending",
      "description": "Stan w\u0119z\u0142a w kolejce synchronizacji (tekst \u2014 booleany nie dzia\u0142aj\u0105 w filtrach funkcji)"
    }
  },
  "required": [
    "node_id",
    "full_path"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}