{
  "name": "AllegroTemplate",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nazwa szablonu (np. 'Odzie\u017c Ciuchy')"
    },
    "producer_name": {
      "type": "string",
      "description": "Nazwa producenta odpowiedzialnego"
    },
    "producer_trade_name": {
      "type": "string",
      "description": "Nazwa w\u0142asna producenta w Allegro"
    },
    "producer_street": {
      "type": "string",
      "description": "Ulica i numer producenta"
    },
    "producer_city": {
      "type": "string",
      "description": "Miasto producenta"
    },
    "producer_zip": {
      "type": "string",
      "description": "Kod pocztowy producenta"
    },
    "producer_country": {
      "type": "string",
      "description": "Kraj producenta"
    },
    "producer_email": {
      "type": "string",
      "description": "Kontakt producenta (email)"
    },
    "responsible_name": {
      "type": "string",
      "description": "Osoba odpowiedzialna (podmiot w UE)"
    },
    "responsible_trade_name": {
      "type": "string",
      "description": "Nazwa w\u0142asna osoby odpowiedzialnej w Allegro"
    },
    "responsible_street": {
      "type": "string"
    },
    "responsible_city": {
      "type": "string"
    },
    "responsible_zip": {
      "type": "string"
    },
    "responsible_country": {
      "type": "string"
    },
    "responsible_email": {
      "type": "string"
    },
    "safety_text": {
      "type": "string",
      "description": "Tekst informacji o bezpiecze\u0144stwie produktu"
    },
    "match_categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Kategorie produkt\u00f3w (lub prefiksy, np. 'clothing'), do kt\u00f3rych szablon dobierany jest automatycznie"
    },
    "safety_type": {
      "type": "string",
      "enum": [
        "ROLE_FULFILLED_BY_MARKETPLACE",
        "NOT_APPLICABLE",
        "DOCUMENT_URL"
      ],
      "default": "ROLE_FULFILLED_BY_MARKETPLACE",
      "description": "Typ informacji o bezpiecze\u0144stwie produktu"
    },
    "safety_url": {
      "type": "string",
      "description": "URL do dokumentu bezpiecze\u0144stwa"
    },
    "invoice": {
      "type": "string",
      "enum": [
        "VAT",
        "NO_INVOICE",
        "VAT_MARGIN"
      ],
      "default": "VAT"
    },
    "handling_time": {
      "type": "string",
      "default": "PT24H"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "producer_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "pracownik"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}