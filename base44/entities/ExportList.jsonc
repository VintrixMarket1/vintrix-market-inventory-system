{
  "name": "ExportList",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nazwa listy eksportowej"
    },
    "product_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "ID produkt\u00f3w na li\u015bcie"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "pracownik"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "pracownik"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "pracownik"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}