{
  "name": "Favorite",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string",
      "description": "ID produktu"
    },
    "product_name": {
      "type": "string",
      "description": "Nazwa produktu (snapshot)"
    },
    "customer_name": {
      "type": "string",
      "description": "Imi\u0119 i nazwisko klienta"
    },
    "customer_email": {
      "type": "string",
      "description": "Email klienta"
    }
  },
  "required": [
    "product_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}