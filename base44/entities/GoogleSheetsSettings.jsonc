{
  "name": "GoogleSheetsSettings",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email u\u017cytkownika"
    },
    "access_token": {
      "type": "string",
      "description": "Token dost\u0119powy Google OAuth (przechowywany do u\u017cycia przez automatyzacje)"
    },
    "spreadsheet_id": {
      "type": "string",
      "description": "ID arkusza Google Sheets"
    },
    "sheet_name": {
      "type": "string",
      "description": "Nazwa zak\u0142adki w arkuszu",
      "default": "Sprzeda\u017c"
    },
    "enabled": {
      "type": "boolean",
      "description": "Czy synchronizacja jest w\u0142\u0105czona",
      "default": true
    }
  },
  "required": [
    "spreadsheet_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}