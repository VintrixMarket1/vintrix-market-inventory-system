{
  "name": "Pallet",
  "type": "object",
  "properties": {
    "pallet_code": {
      "type": "string",
      "description": "Unikalny identyfikator palety np. PAL-001"
    },
    "investor_name": {
      "type": "string",
      "description": "Nazwa inwestora / dostawcy finansujacego palete"
    },
    "purchase_date": {
      "type": "string",
      "format": "date",
      "description": "Data zakupu palety"
    },
    "total_cost": {
      "type": "number",
      "description": "Wartosc zakupowa palety (PLN)"
    },
    "additional_costs": {
      "type": "number",
      "description": "Koszty dodatkowe: transport, rozladunek itp. (PLN)",
      "default": 0
    },
    "total_value": {
      "type": "number",
      "description": "Laczna wartosc palety do rozliczenia (total_cost + additional_costs)"
    },
    "invoice_number": {
      "type": "string",
      "description": "Numer faktury zakupowej"
    },
    "status": {
      "type": "string",
      "enum": [
        "accepted",
        "sorting",
        "ready",
        "exploded",
        "closed"
      ],
      "default": "accepted",
      "description": "Status palety: accepted=Przyjeta, sorting=W trakcie sortowania, ready=Gotowa do rozbicia, exploded=Rozbita, closed=Zamknieta"
    },
    "product_count": {
      "type": "number",
      "description": "Liczba produktow na palecie"
    },
    "calculated_unit_price": {
      "type": "number",
      "description": "Obliczona cena jednostkowa"
    },
    "allocation_method": {
      "type": "string",
      "enum": [
        "equal",
        "proportional",
        "category_weight"
      ],
      "description": "Metoda alokacji wartosci: equal=Rowna, proportional=Proporcjonalna, category_weight=Wagi kategorii"
    },
    "pz_document_id": {
      "type": "string",
      "description": "ID dokumentu PZ"
    },
    "rw_document_id": {
      "type": "string",
      "description": "ID dokumentu RW"
    },
    "pw_document_id": {
      "type": "string",
      "description": "ID dokumentu PW"
    },
    "drp_document_id": {
      "type": "string",
      "description": "ID protokolu rozbicia (DRP)"
    },
    "exploded_at": {
      "type": "string",
      "description": "Data i czas zatwierdzenia rozbicia (ISO)"
    },
    "exploded_by": {
      "type": "string",
      "description": "Email osoby zatwierdzajacej rozbicie"
    },
    "notes": {
      "type": "string",
      "description": "Dodatkowe notatki"
    }
  },
  "required": [
    "pallet_code",
    "investor_name",
    "total_cost"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "pracownik"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "pracownik"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}