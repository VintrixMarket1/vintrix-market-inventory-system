{
  "name": "Pallet",
  "type": "object",
  "properties": {
    "pallet_code": {
      "type": "string",
      "description": "Unikalny identyfikator palety np. PAL-001"
    },
    "investor_name": {
      "type": "string",
      "description": "Nazwa inwestora / dostawcy finansuj\u0105cego palet\u0119"
    },
    "purchase_date": {
      "type": "string",
      "format": "date",
      "description": "Data zakupu palety"
    },
    "total_cost": {
      "type": "number",
      "description": "Warto\u015b\u0107 zakupowa palety (PLN)"
    },
    "additional_costs": {
      "type": "number",
      "description": "Koszty dodatkowe: transport, roz\u0142adunek itp. (PLN)",
      "default": 0
    },
    "total_value": {
      "type": "number",
      "description": "\u0141\u0105czna warto\u015b\u0107 palety do rozliczenia (total_cost + additional_costs)"
    },
    "invoice_number": {
      "type": "string",
      "description": "Numer faktury zakupowej"
    },
    "status": {
      "type": "string",
      "enum": [
        "accepted",
        "sorting",
        "ready",
        "exploded",
        "closed"
      ],
      "default": "accepted",
      "description": "Status palety: accepted=Przyj\u0119ta, sorting=W trakcie sortowania, ready=Gotowa do rozbicia, exploded=Rozbita, closed=Zamkni\u0119ta"
    },
    "product_count": {
      "type": "number",
      "description": "Liczba produkt\u00f3w na palecie"
    },
    "calculated_unit_price": {
      "type": "number",
      "description": "Obliczona cena jednostkowa"
    },
    "allocation_method": {
      "type": "string",
      "enum": [
        "equal",
        "proportional",
        "category_weight"
      ],
      "description": "Metoda alokacji warto\u015bci: equal=R\u00f3wna, proportional=Proporcjonalna, category_weight=Wagi kategorii"
    },
    "pz_document_id": {
      "type": "string",
      "description": "ID dokumentu PZ"
    },
    "rw_document_id": {
      "type": "string",
      "description": "ID dokumentu RW"
    },
    "pw_document_id": {
      "type": "string",
      "description": "ID dokumentu PW"
    },
    "drp_document_id": {
      "type": "string",
      "description": "ID protoko\u0142u rozbicia (DRP)"
    },
    "exploded_at": {
      "type": "string",
      "description": "Data i czas zatwierdzenia rozbicia (ISO)"
    },
    "exploded_by": {
      "type": "string",
      "description": "Email osoby zatwierdzaj\u0105cej rozbicie"
    },
    "notes": {
      "type": "string",
      "description": "Dodatkowe notatki"
    }
  },
  "required": [
    "pallet_code",
    "investor_name",
    "total_cost"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}