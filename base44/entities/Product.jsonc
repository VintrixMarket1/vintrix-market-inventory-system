{
  "name": "Product",
  "type": "object",
  "properties": {
    "product_model_id": {
      "type": "string",
      "description": "Referencja do modelu produktu (ProductModel)"
    },
    "internal_code": {
      "type": "string",
      "description": "Wewn\u0119trzny kod egzemplarza (SKU)"
    },
    "product_name": {
      "type": "string",
      "description": "Nazwa produktu (egzemplarz)"
    },
    "brand": {
      "type": "string",
      "description": "Marka produktu"
    },
    "category": {
      "type": "string",
      "enum": [
        "clothing_men",
        "clothing_women",
        "clothing_kids",
        "clothing_sport",
        "shoes_men",
        "shoes_women",
        "shoes_kids",
        "shoes_sport",
        "accessories_bags",
        "accessories_belts",
        "accessories_hats",
        "accessories_scarves",
        "accessories_jewelry",
        "accessories_watches",
        "accessories_sunglasses",
        "accessories_wallets",
        "electronics_phones",
        "electronics_tablets",
        "electronics_laptops",
        "electronics_audio",
        "electronics_tv",
        "electronics_cameras",
        "electronics_gaming",
        "electronics_accessories",
        "home_furniture",
        "home_kitchen",
        "home_agd_large",
        "home_agd_cleaning",
        "home_agd_personal",
        "home_agd_laundry",
        "home_bedding",
        "home_decor",
        "home_lighting",
        "home_garden",
        "home_tools",
        "home_bathroom",
        "toys_kids",
        "toys_board_games",
        "toys_outdoor",
        "toys_educational",
        "toys_lego",
        "toys_dolls",
        "sports_fitness",
        "sports_cycling",
        "sports_winter",
        "sports_water",
        "sports_team",
        "sports_outdoor",
        "books_fiction",
        "books_nonfiction",
        "books_kids",
        "books_comics",
        "books_textbooks",
        "beauty_cosmetics",
        "beauty_perfumes",
        "beauty_haircare",
        "beauty_skincare",
        "automotive_parts",
        "automotive_accessories",
        "automotive_tools",
        "pet_food",
        "pet_accessories",
        "pet_clothing",
        "food_supplements",
        "health_medical",
        "music_instruments",
        "music_vinyl",
        "art_paintings",
        "art_collectibles",
        "other"
      ],
      "description": "Kategoria produktu"
    },
    "subcategory": {
      "type": "string",
      "description": "Podkategoria produktu"
    },
    "gender": {
      "type": "string",
      "enum": [
        "men",
        "women",
        "unisex",
        "kids",
        "none"
      ],
      "description": "Przeznaczenie p\u0142ciowe"
    },
    "condition": {
      "type": "string",
      "enum": [
        "new",
        "like_new",
        "used"
      ],
      "default": "like_new",
      "description": "Stan produktu"
    },
    "size": {
      "type": "string",
      "description": "Rozmiar (dla odzie\u017cy/but\u00f3w)"
    },
    "color": {
      "type": "string",
      "description": "Kolor produktu"
    },
    "purchase_price": {
      "type": "number",
      "description": "Cena zakupu w PLN (obliczana z kosztu palety)"
    },
    "suggested_sale_price": {
      "type": "number",
      "description": "Sugerowana cena sprzeda\u017cy"
    },
    "notes": {
      "type": "string",
      "description": "Dodatkowe notatki"
    },
    "listing_title": {
      "type": "string",
      "description": "Tytu\u0142 og\u0142oszenia wygenerowany przez AI"
    },
    "listing_description": {
      "type": "string",
      "description": "Opis og\u0142oszenia wygenerowany przez AI"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Zdj\u0119cia tego konkretnego egzemplarza"
    },
    "barcode": {
      "type": "string",
      "description": "Kod kreskowy lub kod r\u0119czny"
    },
    "warehouse_zone": {
      "type": "string",
      "description": "Strefa magazynowa"
    },
    "shelf": {
      "type": "string",
      "description": "Rega\u0142 / miejsce na p\u00f3\u0142ce"
    },
    "box_number": {
      "type": "string",
      "description": "Numer pude\u0142ka"
    },
    "status": {
      "type": "string",
      "enum": [
        "in_stock",
        "listed",
        "sold"
      ],
      "default": "in_stock",
      "description": "Status produktu"
    },
    "pallet_id": {
      "type": "string",
      "description": "Referencja do palety z kt\u00f3rej pochodzi produkt"
    },
    "ai_analyzed": {
      "type": "boolean",
      "default": false,
      "description": "Czy produkt zosta\u0142 przeanalizowany przez AI"
    },
    "ai_verified": {
      "type": "boolean",
      "default": false,
      "description": "Czy dane AI zosta\u0142y zweryfikowane przez operatora"
    },
    "shopify_product_id": {
      "type": "string",
      "description": "ID produktu w Shopify"
    },
    "olx_listing_id": {
      "type": "string",
      "description": "ID og\u0142oszenia na OLX"
    },
    "allegro_listing_id": {
      "type": "string",
      "description": "ID aukcji na Allegro"
    },
    "vinted_listing_id": {
      "type": "string",
      "description": "ID og\u0142oszenia na Vinted"
    },
    "ebay_listing_id": {
      "type": "string",
      "description": "ID aukcji na eBay"
    },
    "is_multi_item": {
      "type": "boolean",
      "default": false,
      "description": "Czy produkt jest wielosztuk\u0119"
    },
    "stock_quantity": {
      "type": "number",
      "description": "Stan magazynowy (liczba sztuk) \u2014 tylko dla wielosztuk\u00f3\u00f3w"
    }
  },
  "required": [
    "product_name",
    "category",
    "condition",
    "purchase_price"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}