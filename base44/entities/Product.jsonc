{
  "name": "Product",
  "type": "object",
  "properties": {
    "product_model_id": {
      "type": "string",
      "description": "Referencja do modelu produktu (ProductModel)"
    },
    "internal_code": {
      "type": "string",
      "description": "Wewnetrzny kod egzemplarza (SKU)"
    },
    "product_name": {
      "type": "string",
      "description": "Nazwa produktu (egzemplarz)"
    },
    "brand": {
      "type": "string",
      "description": "Marka produktu"
    },
    "category": {
      "type": "string",
      "enum": [
        "clothing_men",
        "clothing_women",
        "clothing_kids",
        "clothing_sport",
        "shoes_men",
        "shoes_women",
        "shoes_kids",
        "shoes_sport",
        "accessories_bags",
        "accessories_belts",
        "accessories_hats",
        "accessories_scarves",
        "accessories_jewelry",
        "accessories_watches",
        "accessories_sunglasses",
        "accessories_wallets",
        "electronics_phones",
        "electronics_tablets",
        "electronics_laptops",
        "electronics_audio",
        "electronics_tv",
        "electronics_cameras",
        "electronics_gaming",
        "electronics_accessories",
        "home_furniture",
        "home_kitchen",
        "home_agd_large",
        "home_agd_cleaning",
        "home_agd_personal",
        "home_agd_laundry",
        "home_bedding",
        "home_decor",
        "home_lighting",
        "home_garden",
        "home_tools",
        "home_bathroom",
        "toys_kids",
        "toys_board_games",
        "toys_outdoor",
        "toys_educational",
        "toys_lego",
        "toys_dolls",
        "sports_fitness",
        "sports_cycling",
        "sports_winter",
        "sports_water",
        "sports_team",
        "sports_outdoor",
        "books_fiction",
        "books_nonfiction",
        "books_kids",
        "books_comics",
        "books_textbooks",
        "beauty_cosmetics",
        "beauty_perfumes",
        "beauty_haircare",
        "beauty_skincare",
        "automotive_parts",
        "automotive_accessories",
        "automotive_tools",
        "pet_food",
        "pet_accessories",
        "pet_clothing",
        "food_supplements",
        "health_medical",
        "music_instruments",
        "music_vinyl",
        "art_paintings",
        "art_collectibles",
        "other"
      ],
      "description": "Kategoria produktu"
    },
    "subcategory": {
      "type": "string",
      "description": "Podkategoria produktu"
    },
    "gender": {
      "type": "string",
      "enum": [
        "men",
        "women",
        "unisex",
        "kids",
        "none"
      ],
      "description": "Przeznaczenie plciowe"
    },
    "condition": {
      "type": "string",
      "enum": [
        "new",
        "like_new",
        "used"
      ],
      "default": "like_new",
      "description": "Stan produktu"
    },
    "size": {
      "type": "string",
      "description": "Rozmiar (dla odziezy/butow)"
    },
    "color": {
      "type": "string",
      "description": "Kolor produktu"
    },
    "purchase_price": {
      "type": "number",
      "description": "Cena zakupu w PLN (obliczana z kosztu palety)"
    },
    "suggested_sale_price": {
      "type": "number",
      "description": "Sugerowana cena sprzedazy (cena sprzedazy / promocyjna)"
    },
    "regular_price": {
      "type": "number",
      "description": "Cena regularna (przekreslona) pokazywana przy promocji \u2014 PLN"
    },
    "promo_end_date": {
      "type": "string",
      "format": "date",
      "description": "Data zakonczenia promocji (opcjonalnie)"
    },
    "notes": {
      "type": "string",
      "description": "Dodatkowe notatki"
    },
    "listing_title": {
      "type": "string",
      "description": "Tytul ogloszenia wygenerowany przez AI"
    },
    "listing_description": {
      "type": "string",
      "description": "Opis ogloszenia wygenerowany przez AI"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Zdjecia tego konkretnego egzemplarza"
    },
    "barcode": {
      "type": "string",
      "description": "Kod kreskowy lub kod reczny"
    },
    "warehouse_zone": {
      "type": "string",
      "description": "Strefa magazynowa"
    },
    "shelf": {
      "type": "string",
      "description": "Regal / miejsce na polce"
    },
    "box_number": {
      "type": "string",
      "description": "Numer pudelka"
    },
    "status": {
      "type": "string",
      "enum": [
        "in_stock",
        "listed",
        "sold",
        "reclassified"
      ],
      "default": "in_stock",
      "description": "Status produktu"
    },
    "pallet_id": {
      "type": "string",
      "description": "Referencja do palety z ktorej pochodzi produkt"
    },
    "ai_analyzed": {
      "type": "boolean",
      "default": false,
      "description": "Czy produkt zostal przeanalizowany przez AI"
    },
    "ai_verified": {
      "type": "boolean",
      "default": false,
      "description": "Czy dane AI zostaly zweryfikowane przez operatora"
    },
    "ai_analysis_result": {
      "type": "string",
      "description": "Wynik analizy AI (JSON jako string) \u2014 zachowany dla historii"
    },
    "shopify_product_id": {
      "type": "string",
      "description": "ID produktu w Shopify"
    },
    "olx_listing_id": {
      "type": "string",
      "description": "ID ogloszenia na OLX"
    },
    "allegro_listing_id": {
      "type": "string",
      "description": "ID aukcji na Allegro"
    },
    "allegro_category_id": {
      "type": "string",
      "description": "ID kategorii Allegro z lokalnego drzewa kategorii"
    },
    "allegro_category_path": {
      "type": "string",
      "description": "Pelna sciezka kategorii Allegro"
    },
    "vinted_listing_id": {
      "type": "string",
      "description": "ID ogloszenia na Vinted"
    },
    "ebay_listing_id": {
      "type": "string",
      "description": "ID aukcji na eBay"
    },
    "is_multi_item": {
      "type": "boolean",
      "default": false,
      "description": "Czy produkt jest wielosztuka"
    },
    "stock_quantity": {
      "type": "number",
      "description": "Stan magazynowy (liczba sztuk) \u2014 tylko dla wielosztuk"
    },
    "reclassified_from_id": {
      "type": "string",
      "description": "ID starego produktu (Nieznany przedmiot), z ktorego pochodzi ten produkt po konwersji"
    },
    "reclassified_to_id": {
      "type": "string",
      "description": "ID nowego produktu, na ktory zamieniono ten Nieznany przedmiot"
    },
    "dpt_document_id": {
      "type": "string",
      "description": "ID dokumentu DPT powiazanego z przeklasyfikowaniem"
    },
    "dpt_document_number": {
      "type": "string",
      "description": "Numer dokumentu DPT"
    },
    "action_flag": {
      "type": "boolean",
      "default": false,
      "description": "Czy produkt wymaga podjecia dzialania"
    },
    "action_type": {
      "type": "string",
      "enum": [
        "check",
        "repair",
        "relocation",
        "more_photos",
        "other"
      ],
      "description": "Typ wymaganego dzialania: check=Sprawdzenie, repair=Drobna naprawa, relocation=Relokacja, more_photos=Potrzebne wiecej zdjec, other=Inne"
    },
    "action_note": {
      "type": "string",
      "description": "Notatka opisujaca wymagane dzialanie"
    },
    "action_set_by": {
      "type": "string",
      "description": "Kto oznaczyl produkt (email/nazwa)"
    },
    "action_set_date": {
      "type": "string",
      "description": "Data i czas oznaczenia (ISO)"
    }
  },
  "required": [
    "product_name",
    "category",
    "condition",
    "purchase_price"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "pracownik"
          }
        }
      ]
    },
    "read": {},
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "pracownik"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}