{
  "name": "Sale",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string",
      "description": "Reference to product"
    },
    "listing_id": {
      "type": "string",
      "description": "Reference to listing"
    },
    "platform": {
      "type": "string",
      "enum": [
        "vinted",
        "olx",
        "allegro",
        "ebay",
        "web_store",
        "na_rynku"
      ],
      "description": "Platform where sold"
    },
    "sale_price": {
      "type": "number",
      "description": "Final sale price (po rabacie)"
    },
    "discount_code": {
      "type": "string",
      "description": "Kod rabatowy uzyty przy zakupie (sklep internetowy)"
    },
    "discount_amount": {
      "type": "number",
      "description": "Kwota rabatu (PLN)"
    },
    "sale_date": {
      "type": "string",
      "format": "date",
      "description": "Date of sale"
    },
    "purchase_price": {
      "type": "number",
      "description": "Original purchase price for profit calc"
    },
    "product_name": {
      "type": "string",
      "description": "Product name snapshot"
    },
    "stripe_session_id": {
      "type": "string",
      "description": "Stripe Checkout Session ID"
    },
    "customer_name": {
      "type": "string",
      "description": "Nazwa kupujacego"
    },
    "customer_email": {
      "type": "string",
      "description": "Email kupujacego"
    },
    "shipping_option": {
      "type": "string",
      "description": "Opcja dostawy"
    },
    "wz_document_id": {
      "type": "string",
      "description": "ID dokumentu WZ"
    },
    "wz_document_number": {
      "type": "string",
      "description": "Numer dokumentu WZ"
    },
    "refund_status": {
      "type": "string",
      "enum": [
        "none",
        "partial",
        "full"
      ],
      "default": "none",
      "description": "Status zwrotu srodkow"
    },
    "refund_amount": {
      "type": "number",
      "description": "Kwota zwrotu (PLN)"
    },
    "refund_reason": {
      "type": "string",
      "description": "Powod zwrotu"
    },
    "refund_date": {
      "type": "string",
      "format": "date",
      "description": "Data zwrotu"
    },
    "refund_keeps_product": {
      "type": "boolean",
      "default": true,
      "description": "Czy klient zachowal produkt przy czesciowym zwrocie (true = zachowal, produkt nie wraca do magazynu)"
    },
    "return_cost": {
      "type": "number",
      "description": "Koszty dodatkowe przy pelnym zwrocie (przesylka zwrotna, oplaty platformy np. Vinted) \u2014 PLN"
    },
    "return_cost_description": {
      "type": "string",
      "description": "Opis kosztow dodatkowych przy zwrocie"
    }
  },
  "required": [
    "product_id",
    "platform",
    "sale_price",
    "sale_date"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}