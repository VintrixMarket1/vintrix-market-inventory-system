{
  "name": "Sale",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string",
      "description": "Reference to product"
    },
    "listing_id": {
      "type": "string",
      "description": "Reference to listing"
    },
    "platform": {
      "type": "string",
      "enum": [
        "vinted",
        "olx",
        "allegro",
        "ebay",
        "web_store"
      ],
      "description": "Platform where sold"
    },
    "sale_price": {
      "type": "number",
      "description": "Final sale price"
    },
    "sale_date": {
      "type": "string",
      "format": "date",
      "description": "Date of sale"
    },
    "purchase_price": {
      "type": "number",
      "description": "Original purchase price for profit calc"
    },
    "product_name": {
      "type": "string",
      "description": "Product name snapshot"
    },
    "stripe_session_id": {
      "type": "string",
      "description": "Stripe Checkout Session ID"
    },
    "customer_name": {
      "type": "string",
      "description": "Nazwa kupuj\u0105cego"
    },
    "customer_email": {
      "type": "string",
      "description": "Email kupuj\u0105cego"
    },
    "shipping_option": {
      "type": "string",
      "description": "Opcja dostawy"
    },
    "wz_document_id": {
      "type": "string",
      "description": "ID dokumentu WZ"
    },
    "wz_document_number": {
      "type": "string",
      "description": "Numer dokumentu WZ"
    }
  },
  "required": [
    "product_id",
    "platform",
    "sale_price",
    "sale_date"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}