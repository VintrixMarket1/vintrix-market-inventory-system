{
  "name": "Sale",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string",
      "description": "Reference to product"
    },
    "listing_id": {
      "type": "string",
      "description": "Reference to listing"
    },
    "platform": {
      "type": "string",
      "enum": [
        "vinted",
        "olx",
        "allegro",
        "ebay"
      ],
      "description": "Platform where sold"
    },
    "sale_price": {
      "type": "number",
      "description": "Final sale price"
    },
    "sale_date": {
      "type": "string",
      "format": "date",
      "description": "Date of sale"
    },
    "purchase_price": {
      "type": "number",
      "description": "Original purchase price for profit calc"
    },
    "product_name": {
      "type": "string",
      "description": "Product name snapshot"
    }
  },
  "required": [
    "product_id",
    "platform",
    "sale_price",
    "sale_date"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}",
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "created_by_id": "{{user.id}}",
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "created_by_id": "{{user.id}}",
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "created_by_id": "{{user.id}}",
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}