      "default": "user",
      "description": "Rola u\u017cytkownika: admin = pe\u0142ny dost\u0119p, user = tylko katalog, pracownik = dodawanie produkt\u00f3w i konwersja nieznanych"
    },
    "display_name": {
      "type": "string",
      "description": "Wy\u015bwietlane imi\u0119 i nazwisko (np. Patryk Rezner)"
    }
  }
}