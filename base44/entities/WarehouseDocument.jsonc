{
  "name": "WarehouseDocument",
  "type": "object",
  "properties": {
    "document_number": {
      "type": "string",
      "description": "Numer dokumentu np. PZ/2026/06/001"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "PZ",
        "WZ",
        "RW",
        "PW",
        "DRP",
        "MM",
        "IN",
        "KOR-RW",
        "KOR-PW"
      ],
      "description": "Typ dokumentu"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Data wystawienia dokumentu"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "confirmed"
      ],
      "default": "confirmed",
      "description": "Status dokumentu"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "internal_code": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "condition": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "total_value": {
            "type": "number"
          }
        }
      },
      "description": "Pozycje dokumentu"
    },
    "total_value": {
      "type": "number",
      "description": "\u0141\u0105czna warto\u015b\u0107 dokumentu (PLN)"
    },
    "counterparty": {
      "type": "string",
      "description": "Kontrahent (dostawca / odbiorca)"
    },
    "reference_number": {
      "type": "string",
      "description": "Numer referencyjny / numer faktury zakupowej"
    },
    "platform": {
      "type": "string",
      "enum": [
        "vinted",
        "olx",
        "allegro",
        "ebay",
        "shopify",
        "internal",
        "other"
      ],
      "description": "Platforma sprzeda\u017cy (dla WZ)"
    },
    "pallet_id": {
      "type": "string",
      "description": "Referencja do palety"
    },
    "sale_id": {
      "type": "string",
      "description": "Referencja do rekordu Sale (dla WZ)"
    },
    "related_pz_number": {
      "type": "string",
      "description": "Numer powi\u0105zanego dokumentu PZ"
    },
    "related_rw_number": {
      "type": "string",
      "description": "Numer powi\u0105zanego dokumentu RW"
    },
    "related_pw_number": {
      "type": "string",
      "description": "Numer powi\u0105zanego dokumentu PW"
    },
    "related_drp_number": {
      "type": "string",
      "description": "Numer powi\u0105zanego protoko\u0142u DRP"
    },
    "allocation_method": {
      "type": "string",
      "description": "Metoda alokacji warto\u015bci (dla DRP)"
    },
    "notes": {
      "type": "string",
      "description": "Uwagi do dokumentu"
    },
    "created_by_name": {
      "type": "string",
      "description": "Imi\u0119 i nazwisko / email osoby wystawiaj\u0105cej"
    }
  },
  "required": [
    "document_number",
    "document_type",
    "date",
    "items"
  ]
}