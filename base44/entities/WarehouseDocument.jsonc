{
  "name": "WarehouseDocument",
  "type": "object",
  "properties": {
    "document_number": {
      "type": "string",
      "description": "Numer dokumentu np. PZ/2026/06/001"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "PZ",
        "WZ",
        "RW",
        "MM",
        "IN"
      ],
      "description": "Typ dokumentu: PZ=Przyj\u0119cie Zewn\u0119trzne, WZ=Wydanie Zewn\u0119trzne, RW=Rozch\u00f3d Wewn\u0119trzny, MM=Przesuni\u0119cie Mi\u0119dzymagazynowe, IN=Inwentaryzacja"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Data wystawienia dokumentu"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "confirmed"
      ],
      "default": "confirmed",
      "description": "Status dokumentu: draft=roboczy, confirmed=zatwierdzony"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "internal_code": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number",
            "description": "Cena jednostkowa w momencie operacji (PLN)"
          },
          "total_value": {
            "type": "number",
            "description": "Warto\u015b\u0107 pozycji (qty * unit_price)"
          }
        }
      },
      "description": "Pozycje dokumentu"
    },
    "total_value": {
      "type": "number",
      "description": "\u0141\u0105czna warto\u015b\u0107 dokumentu (PLN)"
    },
    "counterparty": {
      "type": "string",
      "description": "Kontrahent (dostawca / odbiorca)"
    },
    "reference_number": {
      "type": "string",
      "description": "Numer referencyjny (np. numer faktury zakupowej, numer zam\u00f3wienia)"
    },
    "platform": {
      "type": "string",
      "enum": [
        "vinted",
        "olx",
        "allegro",
        "ebay",
        "shopify",
        "internal",
        "other"
      ],
      "description": "Platforma sprzeda\u017cy (dla WZ)"
    },
    "pallet_id": {
      "type": "string",
      "description": "Referencja do palety (dla PZ)"
    },
    "sale_id": {
      "type": "string",
      "description": "Referencja do rekordu Sale (dla WZ)"
    },
    "notes": {
      "type": "string",
      "description": "Uwagi do dokumentu"
    },
    "created_by_name": {
      "type": "string",
      "description": "Imi\u0119 i nazwisko / email osoby wystawiaj\u0105cej"
    }
  },
  "required": [
    "document_number",
    "document_type",
    "date",
    "items"
  ]
}